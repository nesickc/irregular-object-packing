foreach(required_variable IN ITEMS IROP_BENCHMARK_EXECUTABLE IROP_OBJECT_FIXTURE IROP_CONTAINER_FIXTURE IROP_WORK_DIR)
    if(NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
        message(FATAL_ERROR "${required_variable} is required")
    endif()
endforeach()
# Each invocation uses a fresh child; never delete previous measurement evidence.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef attempt)
set(work "${IROP_WORK_DIR}/attempt-${attempt}-tętra-网")
file(MAKE_DIRECTORY "${work}")
file(COPY_FILE "${IROP_OBJECT_FIXTURE}" "${work}/object-tętra-网.stl")
file(SHA256 "${IROP_OBJECT_FIXTURE}" expected_object_hash)
function(run_case name initial_scale)
    execute_process(COMMAND "${IROP_BENCHMARK_EXECUTABLE}" pack
        --object "${work}/object-tętra-网.stl" --container "${IROP_CONTAINER_FIXTURE}"
        --count 2 --seed 1918 --initial-scale "${initial_scale}" --final-scale 1
        --scale-steps 1 --rotation-delta 0 --no-adaptive-sampling --timeout-ms 10000
        --output "${work}/${name}.json" --run-output "${work}/${name}-run"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${name} benchmark process failed: ${result}: ${output} ${error}")
    endif()
    file(READ "${work}/${name}.json" report)
    string(JSON status GET "${report}" status)
    string(JSON physical GET "${report}" physically_valid)
    string(JSON completed GET "${report}" completed_at_exact_target)
    string(JSON loaded GET "${report}" saved_run status)
    string(JSON hash GET "${report}" inputs object sha256)
    string(JSON provenance GET "${report}" build source_sha256_at_configure "src/packing/packing.cpp")
    string(LENGTH "${provenance}" hash_length)
    if(NOT status STREQUAL "success" OR NOT physical OR NOT completed OR NOT loaded STREQUAL "loaded")
        message(FATAL_ERROR "${name} must pack, validate, export and load: ${report}")
    endif()
    if(NOT hash STREQUAL expected_object_hash OR NOT hash_length EQUAL 64)
        message(FATAL_ERROR "${name} source/input provenance is missing or wrong")
    endif()
    string(JSON solves GET "${report}" work local_solves)
    if(name STREQUAL "growth" AND solves LESS 2)
        message(FATAL_ERROR "multi-object growth must execute at least two local solves")
    endif()
    foreach(stage IN ITEMS input_preparation initialization local_solves correction final_validation output_validation export saved_run_loading)
        string(JSON elapsed GET "${report}" stages "${stage}" wall_ms)
        if(elapsed LESS 0)
            message(FATAL_ERROR "invalid stage duration for ${stage}")
        endif()
    endforeach()
endfunction()
run_case(direct 1)
run_case(growth 0.999)
execute_process(COMMAND "${IROP_BENCHMARK_EXECUTABLE}" pack --count 1001
    --output "${work}/invalid.json" RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
if(NOT rejected EQUAL 2 OR EXISTS "${work}/invalid.json")
    message(FATAL_ERROR "benchmark count bounds must be checked before computation")
endif()
