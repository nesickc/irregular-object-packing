{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nesickc/irregular-object-packing/blob/main/docs/schemas/placements-v1.schema.json",
  "title": "IROP placements version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "phase",
    "coordinate_units",
    "transform_convention",
    "object_template",
    "placements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "initialize" },
    "phase": { "const": "initialization" },
    "coordinate_units": { "const": "arbitrary_consistent" },
    "transform_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vector_convention", "rotation_units", "rotation_order", "scale_kind"],
      "properties": {
        "vector_convention": { "const": "column" },
        "rotation_units": { "const": "radians" },
        "rotation_order": { "const": "Ry*Rz*Rx" },
        "scale_kind": { "const": "volume" }
      }
    },
    "object_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "source_vertex_centroid", "centered_at_origin"],
      "properties": {
        "identity": { "const": "object-template" },
        "source_vertex_centroid": { "$ref": "#/$defs/point" },
        "centered_at_origin": { "const": true }
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/placement" }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "matrix_row": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "matrix": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/matrix_row" }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "object_identity",
        "volume_scale",
        "rotation_radians",
        "translation",
        "input_to_world_matrix"
      ],
      "properties": {
        "object_id": { "type": "integer", "minimum": 0 },
        "object_identity": { "const": "object-template" },
        "volume_scale": { "type": "number", "exclusiveMinimum": 0 },
        "rotation_radians": { "$ref": "#/$defs/point" },
        "translation": {
          "description": "World position of the centered object-template origin.",
          "$ref": "#/$defs/point"
        },
        "input_to_world_matrix": {
          "description": "Column-vector affine matrix mapping the original input mesh coordinates directly into world coordinates, including source point-centroid centering.",
          "$ref": "#/$defs/matrix"
        }
      }
    }
  }
}
